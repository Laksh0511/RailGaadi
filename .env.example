# RailRadar / External Indian Railway Live Tracking API Configuration
# Add your API credentials below to switch from built-in simulation to 100% live external data:

RAILRADAR_API_KEY=your_railradar_api_key_here
RAILRADAR_API_URL=https://railradar.in/api/v1

# Alternatively, if you use RapidAPI IRCTC / Indian Railways APIs:
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=irctc1.p.rapidapi.com
